<script>
const questions=[
{id:1,before:"Sara",after:"milk every morning.",options:["don't drink","doesn't drinks","doesn't drink"],correct:"doesn't drink"},
{id:2,before:"They",after:"to school on Friday.",options:["doesn't go","don't go","don't goes"],correct:"don't go"},
{id:3,before:"My father",after:"coffee.",options:["doesn't like","don't likes","doesn't likes"],correct:"doesn't like"},
{id:4,before:"We",after:"TV after school.",options:["doesn't watch","don't watches","don't watch"],correct:"don't watch"},
{id:5,before:"The cat",after:"in the garden.",options:["don't sleep","doesn't sleeps","doesn't sleep"],correct:"doesn't sleep"},
{id:6,before:"I",after:"football every day.",options:["doesn't play","don't plays","don't play"],correct:"don't play"},
{id:7,before:"Ali",after:"his homework at school.",options:["don't do","doesn't does","doesn't do"],correct:"doesn't do"},
{id:8,before:"My friends",after:"pizza every day.",options:["doesn't eat","don't eat","don't eats"],correct:"don't eat"},
{id:9,before:"The bird",after:"at night.",options:["don't sing","doesn't sings","doesn't sing"],correct:"doesn't sing"},
{id:10,before:"Mona",after:"to bed late.",options:["don't go","doesn't goes","doesn't go"],correct:"doesn't go"}
];
let score=0,solvedCount=0,attempts=0,timeLeft=180,timerInterval=null;
let activePill=null,draggedPill=null,ghost=null,startX=0,startY=0,hasMoved=false;
let audioCtx=null;
function playSound(type){
try{
if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();
osc.connect(gain);gain.connect(audioCtx.destination);
if(type==='correct'){
osc.frequency.value=880;gain.gain.value=0.13;osc.start();gain.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.3);osc.stop(audioCtx.currentTime+0.3);
setTimeout(()=>{const o2=audioCtx.createOscillator(),g2=audioCtx.createGain();o2.connect(g2);g2.connect(audioCtx.destination);o2.frequency.value=1108;g2.gain.value=0.13;o2.start();g2.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.32);o2.stop(audioCtx.currentTime+0.32)},120);
}else if(type==='error'){
osc.frequency.value=160;osc.type='sawtooth';gain.gain.value=0.09;osc.start();gain.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.25);osc.stop(audioCtx.currentTime+0.25);
}else if(type==='pop'){
osc.frequency.value=620;gain.gain.value=0.07;osc.start();gain.gain.exponentialRampToValueAtTime(0.01,audioCtx.currentTime+0.15);osc.stop(audioCtx.currentTime+0.15);
}
}catch(e){}
}
function updateUI(){
document.getElementById('scoreDisplay').textContent=score;
const m=document.getElementById('scoreDisplayMobile'); if(m) m.textContent=score;
document.getElementById('progressText').textContent=solvedCount+"/10";
document.getElementById('progressBar').style.width=(solvedCount/10*100)+"%";
document.getElementById('solvedBadge').textContent=solvedCount+" solved";
document.getElementById('attemptsBadge').textContent="Attempts: "+attempts;
}
function updateTimerDisplay(){
const m=String(Math.floor(timeLeft/60)).padStart(2,'0'),s=String(timeLeft%60).padStart(2,'0');
document.getElementById('timerDisplay').textContent=m+":"+s;
const mm=document.getElementById('timerDisplayMobile'); if(mm) mm.textContent=m+":"+s;
if(timeLeft<30){document.getElementById('timerDisplay').classList.add('text-red-600');}
else{document.getElementById('timerDisplay').classList.remove('text-red-600');}
}
function renderQuestions(){
const c=document.getElementById('questionsContainer');
c.innerHTML='';
questions.forEach(q=>{
const card=document.createElement('div');
card.className='question-card py-3 sm:py-3.5 px-1 sm:px-0';
card.innerHTML=`
<div class="flex flex-wrap items-baseline gap-1 sm:gap-1.5 text-[14px] sm:text-[15px] leading-7 text-slate-800">
<span class="font-black text-indigo-600 w-6 sm:w-7 shrink-0">${q.id}.</span>
<span class="font-medium">${q.before}</span>
<span class="drop-zone mx-1 inline-flex items-center justify-center min-w-[148px] sm:min-w-[190px] h-[30px] sm:h-[32px] px-3 border-b-2 border-dotted border-slate-400 bg-slate-50/70 rounded-lg text-[13px] sm:text-[14px] font-semibold text-slate-700" data-q="${q.id}" data-correct="${q.correct}"></span>
<span>${q.after}</span>
</div>
<div class="options-row flex flex-wrap gap-1.5 sm:gap-2 mt-2.5 ml-6 sm:ml-7">
${q.options.map((opt,i)=>{
const label=String.fromCharCode(97+i)+')';
return `<button class="pill inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 sm:py-1.5 bg-white border border-slate-200 rounded-full text-[13px] sm:text-[14px] font-medium text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 hover:shadow-sm" data-q="${q.id}" data-value="${opt}" draggable="true"><span class="text-[11px] font-bold text-slate-400">${label}</span> ${opt}</button>`;
}).join('')}
</div>`;
c.appendChild(card);
});
attachPillListeners();
attachZoneListeners();
}
function attachPillListeners(){
document.querySelectorAll('.pill').forEach(pill=>{
pill.addEventListener('pointerdown',e=>{
if(pill.classList.contains('used-correct')||pill.style.pointerEvents==='none') return;
startX=e.clientX; startY=e.clientY; hasMoved=false; draggedPill=pill;
pill.setPointerCapture(e.pointerId);
});
pill.addEventListener('pointermove',e=>{
if(!draggedPill) return;
const dx=e.clientX-startX, dy=e.clientY-startY;
if(!hasMoved && Math.hypot(dx,dy)>7){
hasMoved=true;
ghost=draggedPill.cloneNode(true);
ghost.style.position='fixed';
ghost.style.left=(e.clientX-draggedPill.offsetWidth/2)+'px';
ghost.style.top=(e.clientY-18)+'px';
ghost.style.pointerEvents='none';
ghost.style.opacity='0.96';
ghost.style.zIndex='9999';
ghost.style.transform='rotate(2deg) scale(1.07)';
ghost.style.boxShadow='0 14px 28px rgba(0,0,0,0.18)';
ghost.style.borderColor='#6366f1';
document.body.appendChild(ghost);
draggedPill.style.opacity='0.35';
if(activePill){activePill.classList.remove('selected','bg-indigo-50','border-indigo-400','ring-2','ring-indigo-200');activePill=null;}
}
if(hasMoved && ghost){
ghost.style.left=(e.clientX-ghost.offsetWidth/2)+'px';
ghost.style.top=(e.clientY-18)+'px';
const el=document.elementFromPoint(e.clientX,e.clientY);
document.querySelectorAll('.drop-zone').forEach(z=>z.classList.remove('drag-over'));
const dz=el&&el.closest?el.closest('.drop-zone'):null;
if(dz && dz.dataset.q===draggedPill.dataset.q && !dz.classList.contains('filled-correct')){
dz.classList.add('drag-over');
}
}
});
const endDrag=(e)=>{
if(!draggedPill) return;
const wasDrag=hasMoved;
document.querySelectorAll('.drop-zone').forEach(z=>z.classList.remove('drag-over'));
if(wasDrag){
const el=document.elementFromPoint(e.clientX,e.clientY);
const dz=el&&el.closest?el.closest('.drop-zone'):null;
if(dz) attemptDrop(draggedPill,dz);
if(ghost) ghost.remove();
ghost=null;
draggedPill.style.opacity='1';
draggedPill=null; hasMoved=false;
e.preventDefault(); e.stopPropagation();
}else{
const p=draggedPill;
draggedPill=null; hasMoved=false;
handlePillClick(p);
}
};
pill.addEventListener('pointerup',endDrag);
pill.addEventListener('pointercancel',()=>{
if(ghost) ghost.remove(); ghost=null;
if(draggedPill) draggedPill.style.opacity='1';
draggedPill=null; hasMoved=false;
document.querySelectorAll('.drop-zone').forEach(z=>z.classList.remove('drag-over'));
});
pill.addEventListener('dragstart',e=>{
e.dataTransfer.setData('text/plain',pill.dataset.value);
e.dataTransfer.effectAllowed='move';
draggedPill=pill;
setTimeout(()=>pill.style.opacity='0.4',0);
});
pill.addEventListener('dragend',()=>{
pill.style.opacity='1';
document.querySelectorAll('.drop-zone').forEach(z=>z.classList.remove('drag-over'));
});
});
}
function handlePillClick(pill){
if(pill.classList.contains('used-correct')||pill.style.pointerEvents==='none') return;
if(activePill===pill){
pill.classList.remove('bg-indigo-50','border-indigo-400','ring-2','ring-indigo-200');
activePill=null; playSound('pop');
}else{
if(activePill) activePill.classList.remove('bg-indigo-50','border-indigo-400','ring-2','ring-indigo-200');
activePill=pill;
pill.classList.add('bg-indigo-50','border-indigo-400','ring-2','ring-indigo-200');
playSound('pop');
}
}
function attachZoneListeners(){
document.querySelectorAll('.drop-zone').forEach(zone=>{
zone.addEventListener('click',()=>{
if(activePill){
attemptDrop(activePill,zone);
activePill.classList.remove('bg-indigo-50','border-indigo-400','ring-2','ring-indigo-200');
activePill=null;
}
});
zone.addEventListener('dragover',e=>{e.preventDefault(); if(!zone.classList.contains('filled-correct')) zone.classList.add('drag-over');});
zone.addEventListener('dragleave',()=>zone.classList.remove('drag-over'));
zone.addEventListener('drop',e=>{
e.preventDefault(); zone.classList.remove('drag-over');
if(draggedPill && draggedPill.dataset.q===zone.dataset.q){
attemptDrop(draggedPill,zone);
}else{
const val=e.dataTransfer.getData('text/plain');
const cand=document.querySelector(`.pill[data-q="${zone.dataset.q}"][data-value="${val}"]`);
if(cand) attemptDrop(cand,zone);
}
});
});
}
function attemptDrop(pill,zone){
if(zone.classList.contains('filled-correct')) return;
if(pill.dataset.q!==zone.dataset.q){
pill.classList.add('wrong'); playSound('error');
setTimeout(()=>pill.classList.remove('wrong'),450);
showToast("That pill belongs to another sentence ✋");
return;
}
const val=pill.dataset.value;
const q=questions.find(x=>x.id==zone.dataset.q);
const isCorrect=val===q.correct;
if(isCorrect){
zone.textContent=val;
zone.classList.add('filled-correct');
zone.classList.remove('drag-over');
pill.classList.add('used-correct');
pill.style.opacity='0.45';
pill.style.pointerEvents='none';
document.querySelectorAll(`.pill[data-q="${q.id}"]`).forEach(p=>{
if(p!==pill){p.style.opacity='0.32'; p.style.pointerEvents='none';}
});
score+=100; solvedCount++; updateUI(); playSound('correct'); launchMiniConfetti(zone);
if(solvedCount===questions.length) setTimeout(()=>showGameOver(true),650);
}else{
zone.classList.add('filled-wrong');
pill.classList.add('wrong');
playSound('error');
attempts++; score=Math.max(0,score-10); updateUI();
zone.textContent=val;
setTimeout(()=>{
if(!zone.classList.contains('filled-correct')){zone.textContent=''; zone.classList.remove('filled-wrong');}
pill.classList.remove('wrong');
},850);
}
}
function launchMiniConfetti(zone){
const rect=zone.getBoundingClientRect();
for(let i=0;i<9;i++){
const c=document.createElement('div');
c.style.position='fixed';
c.style.left=(rect.left+rect.width/2+(Math.random()-0.5)*50)+'px';
c.style.top=rect.top+'px';
c.style.width='7px'; c.style.height='7px';
c.style.borderRadius='50%';
c.style.background=['#6366f1','#22c55e','#f59e0b','#ec4899','#06b6d4'][Math.floor(Math.random()*5)];
c.style.pointerEvents='none';
c.style.zIndex='9999';
c.style.animation='confetti 0.75s ease-out forwards';
document.body.appendChild(c);
setTimeout(()=>c.remove(),800);
}
}
function launchConfetti(){
const cont=document.getElementById('confettiContainer');
if(!cont) return; cont.innerHTML='';
for(let i=0;i<26;i++){
const d=document.createElement('div');
d.style.position='absolute';
d.style.left=Math.random()*100+'%';
d.style.top='-8px';
d.style.width='8px'; d.style.height='8px';
d.style.background=['#fff','#fef08a','#fbcfe8','#ddd6fe','#bbf7d0'][Math.floor(Math.random()*5)];
d.style.borderRadius='2px';
d.style.transform=`rotate(${Math.random()*360}deg)`;
d.style.animation=`confetti ${0.9+Math.random()*0.7}s ease-out forwards`;
d.style.animationDelay=(Math.random()*0.35)+'s';
cont.appendChild(d);
}
}
function showToast(msg){
let t=document.getElementById('toast');
if(!t){
t=document.createElement('div');
t.id='toast';
t.className='fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-5 py-3 rounded-full text-sm font-bold shadow-xl z-50';
document.body.appendChild(t);
}
t.textContent=msg; t.style.opacity='1'; t.style.transform='translate(-50%,0)'; t.style.transition='all 0.3s';
clearTimeout(t._timer);
t._timer=setTimeout(()=>{t.style.opacity='0'; t.style.transform='translate(-50%,12px)';},2600);
}
function showHint(){
const unsolved=questions.find(q=>!document.querySelector(`.drop-zone[data-q="${q.id}"]`).classList.contains('filled-correct'));
if(!unsolved) return;
const pill=document.querySelector(`.pill[data-q="${unsolved.id}"][data-value="${unsolved.correct}"]`);
if(pill){
pill.scrollIntoView({behavior:'smooth',block:'center'});
pill.classList.add('ring-4','ring-amber-300');
pill.animate([{transform:'scale(1)'},{transform:'scale(1.08)'},{transform:'scale(1)'}],{duration:600,iterations:2});
score=Math.max(0,score-5); updateUI();
setTimeout(()=>pill.classList.remove('ring-4','ring-amber-300'),2200);
playSound('pop');
showToast(`Hint: #${unsolved.id} needs "${unsolved.correct}" 💡 -5 pts`);
}
}
function startTimer(){
clearInterval(timerInterval);
timerInterval=setInterval(()=>{
timeLeft--; updateTimerDisplay();
if(timeLeft<=0){clearInterval(timerInterval); showGameOver(false);}
},1000);
}
function startGame(){
score=0; solvedCount=0; attempts=0; timeLeft=180;
updateUI(); updateTimerDisplay();
document.querySelectorAll('.drop-zone').forEach(z=>{
z.textContent=''; z.className='drop-zone mx-1 inline-flex items-center justify-center min-w-[148px] sm:min-w-[190px] h-[30px] sm:h-[32px] px-3 border-b-2 border-dotted border-slate-400 bg-slate-50/70 rounded-lg text-[13px] sm:text-[14px] font-semibold text-slate-700';
});
document.querySelectorAll('.pill').forEach(p=>{
p.className='pill inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 bg-white border border-slate-200 rounded-full text-[13px] sm:text-[14px] font-medium text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 hover:shadow-sm';
p.style.opacity='1'; p.style.pointerEvents='auto';
});
activePill=null; draggedPill=null; if(ghost){ghost.remove();ghost=null;}
clearInterval(timerInterval); startTimer();
const gm=document.getElementById('gameOverModal'); gm.classList.add('hidden'); gm.classList.remove('flex');
document.getElementById('startScreen').style.display='none';
playSound('pop');
}
function showGameOver(success){
clearInterval(timerInterval);
const modal=document.getElementById('gameOverModal');
modal.classList.remove('hidden'); modal.classList.add('flex');
const title=document.getElementById('gameOverTitle');
const desc=document.getElementById('gameOverDesc');
const stars=document.getElementById('starsContainer');
const scoreEl=document.getElementById('finalScore');
const timeEl=document.getElementById('finalTime');
const accEl=document.getElementById('finalAccuracy');
const msg=document.getElementById('resultMessage');
let starCount=1;
if(solvedCount===10 && attempts<=2) starCount=3;
else if(solvedCount>=8) starCount=2;
else if(solvedCount>=5) starCount=1;
if(!success && solvedCount<10){
title.textContent=timeLeft<=0?"Time's Up! ⏰":"Keep Practicing! 💪";
desc.textContent=`You solved ${solvedCount}/10. You can do it!`;
starCount=solvedCount>=7?2:1;
msg.textContent="Tip: 'He/She/It' → doesn't + verb. 'I/We/They' → don't + verb.";
msg.className="bg-amber-50 border border-amber-200 rounded-xl p-3 text-sm text-amber-800 text-center mb-4";
}else if(solvedCount===10){
if(starCount===3){title.textContent="Perfect Grammar Star! 🌟"; desc.textContent="Flawless! You mastered don't / doesn't!"; msg.textContent="🌟 Incredible! Zero or very few mistakes — you're a grammar master!"; msg.className="bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-sm text-emerald-800 text-center mb-4";}
else if(starCount===2){title.textContent="Great Job! 🎉"; desc.textContent="You nailed most sentences!"; msg.textContent="👏 Strong work! Review the ones you missed and aim for 3 stars!"; msg.className="bg-indigo-50 border border-indigo-100 rounded-xl p-3 text-sm text-indigo-800 text-center mb-4";}
else{title.textContent="Well Done! 👍"; desc.textContent="All 10 completed — keep polishing!"; msg.textContent="💪 You finished! Try again to get fewer errors and earn 3 stars."; msg.className="bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm text-slate-700 text-center mb-4";}
}else{
title.textContent="Good Effort! 👍"; desc.textContent=`You solved ${solvedCount}/10`;
msg.textContent="You're improving! Focus on he/she/it vs I/we/they.";
}
stars.innerHTML='★'.repeat(starCount)+'<span style="opacity:0.2">'+'★'.repeat(3-starCount)+'</span>';
scoreEl.textContent=score;
timeEl.textContent=(180-timeLeft)+'s';
accEl.textContent=solvedCount+'/10';
if(success && starCount===3) launchConfetti();
}
document.addEventListener('DOMContentLoaded',()=>{
renderQuestions(); updateUI(); updateTimerDisplay();
document.getElementById('playBtn').addEventListener('click',startGame);
document.getElementById('resetBtn').addEventListener('click',()=>{
if(document.getElementById('startScreen').style.display!=='none') return;
startGame(); showToast("Game reset! 🔄");
});
document.getElementById('hintBtn').addEventListener('click',showHint);
document.getElementById('hintBtnMobile').addEventListener('click',showHint);
document.getElementById('checkBtn').addEventListener('click',()=>{
if(solvedCount===questions.length) showGameOver(true);
else{
document.querySelectorAll('.drop-zone:not(.filled-correct)').forEach(z=>{
z.animate([{transform:'translateX(0)'},{transform:'translateX(-4px)'},{transform:'translateX(4px)'},{transform:'translateX(0)'}],{duration:350});
});
showToast(`You still have ${10 - solvedCount} blank(s) to fill! 💪`);
playSound('error');
}
});
document.getElementById('playAgainBtn').addEventListener('click',startGame);
document.getElementById('reviewBtn').addEventListener('click',()=>{
const m=document.getElementById('gameOverModal'); m.classList.add('hidden'); m.classList.remove('flex');
showToast("Review your answers below 👇");
});
});
</script>
</body>
</html>
