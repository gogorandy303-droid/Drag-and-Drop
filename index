<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Inter:wght@500;600;700&display=swap" rel="stylesheet">
<style>
*{font-family:'Inter',system-ui,sans-serif}
h1,h2,h3{font-family:'Nunito',sans-serif}
.drop-zone.drag-over{border-color:#6366f1!important;background:#eef2ff!important;transform:scale(1.02);box-shadow:0 0 0 3px rgba(99,102,241,0.15)}
.drop-zone.filled-correct{border:2px solid #22c55e!important;background:#dcfce7!important;color:#15803d!important;font-weight:700!important;border-bottom-style:solid!important}
.drop-zone.filled-wrong{border-color:#ef4444!important;background:#fee2e2!important;animation:shake 0.4s ease}
.pill.wrong{animation:shake 0.4s ease;border-color:#ef4444!important;background:#fee2e2!important}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
@keyframes pop{0%{transform:scale(0.86);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes confetti{0%{transform:translateY(-10px) rotate(0deg);opacity:1}100%{transform:translateY(260px) rotate(720deg);opacity:0}}
.pill{user-select:none;-webkit-user-select:none;touch-action:manipulation}
.question-card{transition:background 0.2s}
@media(max-width:640px){.drop-zone{min-width:130px!important}}
</style>
